/* ==========================================================================
   SIMM Medical Treatment Console - Carbon-Ion Therapy Web-Level Theme (Fluent Slate)
   对标网页版碳离子治疗系统 C-NEXUS-TCS2000 设计语言
   ========================================================================== */

QMainWindow,
QWidget {
    background: #F1F5F9;
    color: #0F172A;
    font-family: "PingFang SC", "Microsoft YaHei", "Segoe UI", -apple-system, sans-serif;
    font-size: 13px;
}

/* --- 卡片与分组容器 (Clean Modern Medical Cards) --- */
QFrame#cardFrame,
QFrame#panelFrame,
QGroupBox {
    background: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 8px;
    margin-top: 8px;
    padding-top: 8px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 6px;
    color: #0F172A;
    font-weight: 700;
    font-size: 13px;
}

/* 床位视口与核心中控台无缝融合 */
QGroupBox#groupBoxBedPreview {
    background: #F8FAFC;
    border: 1px solid #E2E8F0;
    border-radius: 8px;
}

/* 顶部流程与安全卡片专用浅色底 */
QWidget#widget_topBanner,
QFrame#frameSafetyInterlocks {
    background: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 8px;
}

/* --- 文本与标签 --- */
QLabel {
    background: transparent;
    color: #475569;
}

QLabel#label_title_patient,
QLabel#label_title_doctor,
QLabel#label_title_room,
QLabel#label_title_time,
QLabel#label_title_plan,
QLabel#label_title_flow,
QLabel#label_title_status,
QLabel#label_title_ops,
QLabel#label_title_bed,
QLabel#label_preview_title {
    color: #0F172A;
    font-weight: 700;
    font-size: 13px;
}

QLabel#patient_name,
QLabel#label_user,
QLabel#label_room,
QLabel#label_time {
    color: #0F172A;
    font-size: 13px;
    font-weight: 600;
}

QLabel#labelTopPrescriptionDose,
QLabel#label_30 {
    color: #2563EB;
    font-size: 18px;
    font-weight: 700;
    font-family: "Menlo", "Monaco", monospace;
}

/* --- 按钮 (Modern Fluent Slate & Tech Blue) --- */
QPushButton {
    background: #FFFFFF;
    border: 1px solid #CBD5E1;
    border-radius: 6px;
    padding: 5px 12px;
    min-height: 24px;
    color: #334155;
    font-weight: 500;
    font-size: 12px;
}

QPushButton:hover {
    background: #EFF6FF;
    border: 1px solid #93C5FD;
    color: #1D4ED8;
}

QPushButton:pressed {
    background: #DBEAFE;
    border: 1px solid #2563EB;
}

QPushButton:disabled {
    background: #F8FAFC;
    color: #94A3B8;
    border: 1px solid #E2E8F0;
}

/* 申请出束许可核心药丸大按钮（与网页版一致） */
QPushButton#beamApply_pushButton {
    background: #2563EB;
    color: #FFFFFF;
    border: none;
    border-radius: 8px;
    min-height: 38px;
    font-size: 14px;
    font-weight: 700;
    padding: 6px 18px;
}

QPushButton#beamApply_pushButton:hover {
    background: #1D4ED8;
}

QPushButton#beamApply_pushButton:pressed {
    background: #1E40AF;
}

/* 计划详情与排程确认按钮 */
QPushButton#confirmPlan_pushButton,
QPushButton#todaySchedule_pushButton {
    background: #2563EB;
    color: #FFFFFF;
    border: none;
    border-radius: 6px;
    font-weight: 600;
    min-height: 28px;
}

QPushButton#confirmPlan_pushButton:hover,
QPushButton#todaySchedule_pushButton:hover {
    background: #1D4ED8;
}

QPushButton#planDetail_pushButton {
    background: #EFF6FF;
    color: #1D4ED8;
    border: 1px solid #BFDBFE;
    border-radius: 6px;
    font-weight: 600;
    min-height: 28px;
}

QPushButton#planDetail_pushButton:hover {
    background: #DBEAFE;
    border: 1px solid #93C5FD;
}

/* 注销与紧急停止按钮 */
QPushButton#logout_pushButton {
    color: #DC2626;
    border: 1px solid #FECDD3;
    background: #FFF1F2;
    border-radius: 6px;
    font-weight: 600;
}

QPushButton#logout_pushButton:hover {
    background: #FEE2E2;
    border: 1px solid #FDA4AF;
}

/* --- 输入控件、下拉框、表格与面板 --- */
QComboBox,
QLineEdit,
QTextEdit,
QPlainTextEdit,
QTableWidget,
QTableView,
QTabWidget::pane {
    background: #FFFFFF;
    border: 1px solid #CBD5E1;
    border-radius: 6px;
    color: #0F172A;
}

QComboBox,
QLineEdit {
    min-height: 28px;
    padding: 2px 8px;
}

QLineEdit:focus,
QComboBox:focus {
    border: 1px solid #2563EB;
    background: #FFFFFF;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 22px;
    border-left: 1px solid #E2E8F0;
}

QComboBox QAbstractItemView {
    background: #FFFFFF;
    border: 1px solid #CBD5E1;
    selection-background-color: #2563EB;
    selection-color: #FFFFFF;
}

/* 表格 (Table View) 纯白清爽设计 */
QTableWidget,
QTableView {
    gridline-color: #F1F5F9;
    alternate-background-color: #F8FAFC;
    selection-background-color: #EFF6FF;
    selection-color: #1D4ED8;
}

QHeaderView::section {
    background: #F8FAFC;
    color: #475569;
    padding: 6px 8px;
    border: none;
    border-bottom: 1px solid #E2E8F0;
    font-weight: 600;
    font-size: 12px;
}

/* 标签页 (Tab Widget) */
QTabBar::tab {
    background: #F1F5F9;
    border: 1px solid #E2E8F0;
    border-bottom: none;
    padding: 6px 14px;
    margin-right: 4px;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    color: #64748B;
}

QTabBar::tab:selected {
    background: #FFFFFF;
    border-color: #E2E8F0;
    border-top: 2px solid #2563EB;
    color: #2563EB;
    font-weight: 600;
}

QTabBar::tab:hover:!selected {
    background: #E2E8F0;
    color: #0F172A;
}

/* 极简清爽滚动条 */
QScrollBar:vertical {
    background: transparent;
    width: 6px;
    margin: 0px;
    border-radius: 3px;
}

QScrollBar::handle:vertical {
    background: #CBD5E1;
    min-height: 20px;
    border-radius: 3px;
}

QScrollBar::handle:vertical:hover {
    background: #94A3B8;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar:horizontal {
    background: transparent;
    height: 6px;
    margin: 0px;
    border-radius: 3px;
}

QScrollBar::handle:horizontal {
    background: #CBD5E1;
    min-width: 20px;
    border-radius: 3px;
}

QScrollBar::handle:horizontal:hover {
    background: #94A3B8;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0px;
}

/* 状态栏 (Status Bar) */
QStatusBar {
    background: #FFFFFF;
    color: #64748B;
    border-top: 1px solid #E2E8F0;
    font-size: 12px;
}

QStatusBar::item {
    border: none;
}
